{
  "name": "@elinpf/dsh-ops-knowledge",
  "version": "0.3.0",
  "description": "Troubleshooting knowledge base for ops mode — distilled postmortem cases stored in the access hub, searched before diagnosing and recorded after resolving.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.8",
    "@elinpf/dsh-ops-prompts": "^0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1",
    "@elinpf/dsh-ops-access-hub": "workspace:*",
    "@elinpf/dsh-ops-prompts": "workspace:*",
    "@elinpf/dsh-ops-test-support": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
