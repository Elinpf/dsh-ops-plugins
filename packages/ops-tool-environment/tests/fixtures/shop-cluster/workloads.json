{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "shop-frontend",
        "namespace": "shop",
        "labels": {
          "app.kubernetes.io/name": "frontend",
          "app.kubernetes.io/instance": "shop",
          "app.kubernetes.io/managed-by": "Helm",
          "helm.sh/chart": "frontend-0.4.0"
        }
      },
      "spec": {
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "frontend",
              "app.kubernetes.io/instance": "shop"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "frontend",
                "image": "bitnami/nginx:1.25.4",
                "env": [
                  { "name": "DATABASE_URL", "value": "postgres://shop-postgresql.data.svc.cluster.local:5432/shop" },
                  { "name": "SELF_CHECK", "value": "http://shop-frontend.shop.svc.cluster.local/healthz" }
                ],
                "envFrom": [
                  { "configMapRef": { "name": "shop-frontend-config" } }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "shop-postgresql",
        "namespace": "data",
        "labels": {
          "app.kubernetes.io/name": "postgresql",
          "app.kubernetes.io/instance": "shop",
          "app.kubernetes.io/managed-by": "Helm",
          "helm.sh/chart": "postgresql-15.5.0"
        }
      },
      "spec": {
        "serviceName": "shop-postgresql",
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "postgresql",
              "app.kubernetes.io/instance": "shop"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "postgresql",
                "image": "bitnami/postgresql:16.3.0"
              }
            ]
          }
        }
      }
    }
  ]
}
