{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "Ingress",
      "metadata": { "name": "baizeops", "namespace": "baizeops" },
      "spec": {
        "rules": [
          {
            "host": "ops.example.com",
            "http": {
              "paths": [
                {
                  "path": "/",
                  "backend": { "service": { "name": "gateway", "port": { "number": 8080 } } }
                },
                {
                  "path": "/api/users",
                  "backend": { "service": { "name": "user-service", "port": { "name": "http" } } }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
