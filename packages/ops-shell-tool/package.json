{
  "name": "@elinpf/dsh-ops-shell-tool",
  "version": "0.1.0",
  "description": "Shared factory for ops-access consumer tools: standard shell result shape, output schema, render, and the resolve-per-call execute template.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types.js",
    "lib/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@elinpf/dsh-ops-access": "^0.1.0",
    "@deepseek-ai/dsh-shell": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@elinpf/dsh-ops-access": "workspace:*",
    "@deepseek-ai/dsh-shell": "0.0.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
